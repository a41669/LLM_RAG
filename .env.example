# 模板: 复制为 .env 后填入你自己的 Key
#   Git Bash / macOS:  cp .env.example .env
#   PowerShell:        Copy-Item .env.example .env
# .env 已被 .gitignore 排除, 只有这个模板会进 GitHub。

# ① 百炼(阿里云) Embedding Key
#    默认走 local 本地模型(离线、免费), 留空也能跑; 想用云端向量化才填
EMBED_API_KEY=

# ② DeepSeek Key —— 负责根据检索结果生成回答, 必填
CHAT_API_KEY=

# 可选: embedding 提供方
#   local    本地 ONNX 模型(all-MiniLM-L6-v2), 离线免费, 默认
#   bailian  阿里云百炼 text-embedding-v3
#   zhipu    智谱 embedding-3(有免费额度)
#   openai   OpenAI text-embedding-3-small
EMBED_PROVIDER=local
