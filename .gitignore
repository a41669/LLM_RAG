# ============ 敏感信息: 绝不提交 ============
.env
.env.*
!.env.example
*.key
*.pem
secrets.*

# ============ Python ============
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ============ 运行时产物 (体积大 / 可重新生成) ============
# 向量库几百 MB, clone 的人自己跑 --ingest 生成即可
chroma_db/
_ingest_db/
# 用户上传的书 + 索引(含版权内容)
uploads/

# ============ 工具私有目录 ============
.workbuddy/

# ============ 编辑器 / 系统 ============
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# ============ 版权内容: 书籍原文 ============
# 《如何学会学习》等 txt/epub 是有版权的出版物, 公开仓库放全文有侵权风险。
# 建议让 clone 的人自己放书进去。若你确认有授权, 删掉下面两行即可提交。
docs/*.txt
docs/*.epub
